module WinSDK [system] {
  module WinSock2 {
    header "sdk/um/WinSock2.h"
    header "sdk/um/WS2tcpip.h"
    header "sdk/um/MSWSock.h"
    header "sdk/shared/afunix.h"
    export *

    link "WS2_32.Lib"
  }

  module WinSock {
    header "sdk/um/winsock.h"
  }

  module core {
    module acl {
      header "sdk/um/AclAPI.h"
      export *
    }

    module com {
      header "sdk/um/combaseapi.h"
      export *
    }

    module compress {
      header "sdk/um/compressapi.h"
      export *
    }

    module console {
      header "sdk/um/consoleapi.h"
      header "sdk/um/consoleapi2.h"
      header "sdk/um/consoleapi3.h"
      export *
    }

    // api-ms-win-core-errhandling-l1-1-0.dll
    module errhandling {
      header "sdk/um/errhandlingapi.h"
      export *
    }

    // api-ms-win-core-file-l1-1-0.dll
    module file {
      header "sdk/um/fileapi.h"
      export *
    }

    // api-ms-win-core-handle-l1-1-0.dll
    module handle {
      header "sdk/um/handleapi.h"
      export *
    }

    // api-ms-win-heapapi-l1-1-0.dll
    module heap {
      header "sdk/um/heapapi.h"
      export *
    }

    // api-ms-win-core-interlocked-l1-1-0.dll
    module interlocked {
      header "sdk/um/interlockedapi.h"
      export *
    }

    // iphlpapi.dll
    module iphlp {
      header "sdk/um/iphlpapi.h"
      export *

      link "iphlpapi.lib"
    }

    // api-ms-win-core-libloader-l1-1-0.dll
    module libloader {
      header "sdk/um/libloaderapi.h"
      export *
    }

    // api-ms-win-core-memory-l1-1-0.dll
    module memory {
      header "sdk/um/memoryapi.h"
      export *

      link "OneCore.Lib"
    }

    // api-ms-win-core-namedpipe-l1-1-2-0.dll
    module namedpipe {
      header "sdk/um/namedpipeapi.h"
      export *
    }

    // api-ms-win-core-Path-l1-0.dll
    module path {
      header "sdk/um/PathCch.h"
      export *

      link "pathcch.lib"
    }

    // api-ms-win-core-processthreads-l1-1-2.dll
    module processthreads {
      header "sdk/um/processthreadsapi.h"
      export *
    }

    // api-ms-win-core-synch-l1-2-0.dll
    module synch {
      header "sdk/um/synchapi.h"
      export *
    }

    // api-ms-win-core-sysinfo-l1-1-0.dll
    module sysinfo {
      header "sdk/um/sysinfoapi.h"
      export *
    }

    // api-ms-win-core-timezone-l1-1-0.dll
    module timezone {
      header "sdk/um/timezoneapi.h"
      export *
    }

    // api-ms-win-core-version-l1-1-0.dll
    module version {
      header "sdk/um/winver.h"
      export *

      link "Version.Lib"
    }
  }

  module ActiveX {
    header "sdk/um/OCIdl.h"
    export *
  }

  module Controls {
    module CommCtrl {
      header "sdk/um/CommCtrl.h"
      export *

      link "ComCtl32.Lib"
    }

    module CommDlg {
      header "sdk/um/commdlg.h"
      export *

      link "ComDlg32.Lib"
    }
  }

  explicit module DirectX {
    module Direct3D11 {
      header "sdk/um/d3d11.h"
      header "sdk/um/d3d11_1.h"
      header "sdk/um/d3d11_2.h"
      header "sdk/um/d3d11_3.h"
      header "sdk/um/d3d11_4.h"
      export *

      link "d3d11.lib"
      link "dxgi.lib"
    }

    module Direct3D12 {
      header "sdk/um/d3d12.h"
      export *

      link "d3d12.lib"
      link "dxgi.lib"
    }

    // FIXME(compnerd) DXGI is part of the Direct3D interfaces currently; we
    // should split it out, but because it is part of the D3D11 interfaces, this
    // separate module is meant to augment the uncovered portions only.
    module _DXGI {
      header "sdk/shared/dxgi1_6.h"
      header "sdk/um/dxgidebug.h"
      export *

      link "dxgi.lib"
    }

    module D3DCompiler {
      header "sdk/um/d3dcompiler.h"
      export *

      link "d3dcompiler.lib"
    }

    module XAudio29 {
      header "sdk/um/xaudio2.h"
      header "sdk/um/xaudio2fx.h"
      export *

      link "xaudio2.lib"

      requires cplusplus
    }

    // XInput 1.4 (Windows 10, XBox) is newer than the XInput 9.1.0 which was
    // part of Vista.
    module XInput14 {
      header "sdk/um/Xinput.h"
      export *

      link "xinput.lib"
    }

    link "dxguid.lib"
  }

  // FIXME(compnerd) this is a hack for the HWND typedef for DbgHelp
  module __DirectX {
    header "sdk/um/directmanipulation.h"
    export *
  }

  module DFS {
    header "sdk/um/LMDFS.h"
    header "sdk/um/LM.h"
    export *

    link "NetAPI32.Lib"
  }

  module DWM {
    header "sdk/um/dwmapi.h"
    export *

    link "dwmapi.lib"
  }

  module FCI {
    header "sdk/um/fci.h"
    export *

    link "Cabinet.Lib"
  }

  module Internationalization {
    module WinNLS {
      header "sdk/um/winnls.h"
      export *
    }

    module IMM {
      header "sdk/um/immdev.h"
      header "sdk/um/imm.h"
      export *

      link "Imm32.lib"
    }
  }

  module Multimedia {
    module DigitalVideo {
      header "sdk/um/Digitalv.h"
      export *
    }

    module Video {
      header "sdk/um/Vfw.h"
      export *

      link "Vfw32.Lib"
    }

    header "sdk/um/mmeapi.h"
    header "sdk/um/mmddk.h"
    header "sdk/um/mmsystem.h"
    header "sdk/um/mmiscapi.h"
    header "sdk/um/timeapi.h"
    header "sdk/um/joystickapi.h"
    export *

    link "WinMM.Lib"
  }

  module Networking {
    header "sdk/um/winnetwk.h"
    export *

    link "Mpr.Lib"
  }

  module Security {
    module AuthZ {
      header "sdk/um/AuthZ.h"
      export *

      link "AuthZ.Lib"
    }

    module SmartCard {
      header "sdk/um/winscard.h"
      export *

      link "winscard.lib"
    }

    module WinCrypt {
      header "sdk/um/wincrypt.h"
      export *

      link "Crypt32.Lib"
    }
  }

  module Shell {
    header "sdk/um/ShlObj.h"
    export *
  }

  module AppNotify {
    header "sdk/um/appnotify.h"
    export *

    link "appnotify.lib"
  }

  module ShellAPI {
    header "sdk/um/shellapi.h"
    header "sdk/um/Shlwapi.h"
    export *

    link "shell32.lib"
    link "ShLwApi.Lib"
  }

  module ShellCore {
    header "sdk/um/ShellScalingApi.h"
    export *

    link "shcore.lib"
  }

  module System {
    module DbgHelp {
      header "sdk/um/DbgHelp.h"
      export *

      link "DbgHelp.Lib"
    }

    module IOCTL {
      header "sdk/um/winioctl.h"
      export *
    }

    module MCX {
      header "sdk/um/mcx.h"
      export *
    }
  }

  module OLE32 {
    header "sdk/um/oaidl.h"
    export *

    link "OleAut32.Lib"
  }

  module Performance {
    module PerfLib {
      header "sdk/um/perflib.h"
      export *

      link "AdvAPI32.Lib"
    }

    module PDH {
      header "sdk/um/Pdh.h"
      export *

      link "Pdh.Lib"
    }

    header "sdk/um/winperf.h"
    export *
  }

  module Printing {
    header "sdk/um/winspool.h"
    export *

    link "WinSpool.Lib"
  }

  module PSAPI {
    header "sdk/um/Psapi.h"
    export *

    link "psapi.lib"
  }

  module RichEdit {
    header "sdk/um/Richedit.h"
    export *
  }

  module Sensors {
    header "sdk/um/sensors.h"
    header "sdk/um/SensorsApi.h"
    export *

    link "sensorsapi.lib"
  }

  module ToolHelp {
    header "sdk/um/TlHelp32.h"
    export *

    link "kernel32.Lib"
  }

  module UI {
    module XAML {
      module Hosting {
        header "sdk/um/windows.ui.xaml.hosting.desktopwindowxamlsource.h"
        export *
      }
    }
  }

  module User {
    header "sdk/um/WinUser.h"
    export *
    link "User32.Lib"
  }

  module WIC {
    header "sdk/um/wincodec.h"
    export *

    link "windowscodecs.lib"
  }

  module WinBase {
    header "sdk/um/winbase.h"
    export *
  }

  module WinDNS {
    header "sdk/um/WinDNS.h"
    export *

    link "DnsAPI.Lib"
  }

  module WinGDI {
    header "sdk/um/wingdi.h"
    export *

    link "Gdi32.Lib"
  }

  module WinNT {
    header "sdk/um/winnt.h"
    export *
  }

  module WinReg {
    header "sdk/um/winreg.h"
    export *

    link "AdvAPI32.Lib"
  }

  module WinRPC {
    header "sdk/shared/rpc.h"
    header "sdk/shared/rpcndr.h"
    export *

    link "RpcRT4.Lib"
  }

  module WinSVC {
    header "sdk/um/winsvc.h"
    export *

    link "AdvAPI32.Lib"
  }

  module WinSafer {
    header "sdk/um/winsafer.h"
    export *

    link "AdvAPI32.Lib"
  }
  
  module WinUSB {
    header "sdk/um/winusb.h"
    export *
    
    link "winusb.lib"
  }

  // TODO(compnerd) does it make sense to implicitly export this API surface?
  // It seems to be meant for device drivers.
  module WLANAPI {
    header "sdk/um/wlanapi.h"
    header "sdk/um/wlanihv.h"
    header "sdk/um/wlclient.h"

    link "wlanapi.lib"
  }
}
