module _visualc_intrinsics [system] [extern_c] {
  explicit module arm {
    requires armv7
    header "msvc/armintr.h"

    explicit module neon {
      requires neon
      header "msvc/arm_neon.h"
    }
  }

  explicit module aarch64 {
    requires aarch64
    header "msvc/arm64intr.h"

    explicit module neon {
      requires neon
      header "msvc/arm64_neon.h"
    }
  }

  explicit module intel {
    requires x86
    export *

    header "msvc/immintrin.h"

    explicit module mmx {
      header "msvc/mmintrin.h"
    }

    explicit module sse {
      export mmx
      header "msvc/xmmintrin.h"
    }

    explicit module sse2 {
      export sse
      header "msvc/emmintrin.h"
    }

    explicit module sse3 {
      export sse2
      header "msvc/pmmintrin.h"
    }

    explicit module ssse3 {
      export sse3
      header "msvc/tmmintrinh"
    }

    explicit module sse4_1 {
      export ssse3
      header "msvc/smmintrin.h"
    }

    explicit module sse4_2 {
      export sse4_1
      header "msvc/nmmintrin.h"
    }

    explicit module sse4a {
      export sse3
      header "msvc/ammintrin.h"
    }

    explicit module aes_pclmul {
      header "msvc/wmmintrin.h"
      export aes
      export pclmul
    }
  }
}

module visualc [system] {
  module SAL {
    header "msvc/sal.h"
    export *
  }

  module vcruntime {
    header "msvc/vcruntime.h"
    export *
  }

  module setjmp {
    header "msvc/setjmp.h"
    export *
  }

  module stdint {
    header "msvc/stdint.h"
    export *
  }
}
