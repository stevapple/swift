module ucrt [system] {
  module C {
    module complex {
      header "sdk/ucrt/complex.h"
      export *
    }

    module ctype {
      header "sdk/ucrt/ctype.h"
      export *
    }

    module errno {
      header "sdk/ucrt/errno.h"
      export *
    }

    module fenv {
      header "sdk/ucrt/fenv.h"
      export *
    }

    module inttypes {
      header "sdk/ucrt/inttypes.h"
      export *
    }

    module locale {
      header "sdk/ucrt/locale.h"
      export *
    }

    module math {
      header "sdk/ucrt/math.h"
      export *
    }

    module signal {
      header "sdk/ucrt/signal.h"
      export *
    }

    module stddef {
      header "sdk/ucrt/stddef.h"
      export *
    }

    module stdio {
      header "sdk/ucrt/stdio.h"
      export *

      // NOTE(compnerd) this is a horrible workaround for the fact that
      // Microsoft has fully inlined nearly all of the printf family of
      // functions in the headers which results in the definitions being elided
      // resulting in undefined symbols.  The legacy_stdio_definitions provides
      // out-of-line definitions for these functions.
      link "legacy_stdio_definitions"
    }

    module stdlib {
      header "sdk/ucrt/stdlib.h"
      export *
    }

    module string {
      header "sdk/ucrt/string.h"
      export *
    }

    module time {
      header "sdk/ucrt/time.h"
      export *
    }

    module POSIX {
      module fcntl {
        header "sdk/ucrt/fcntl.h"
        export *
      }

      module sys {
        export *

        module stat {
          header "sdk/ucrt/sys/stat.h"
          header "sdk/ucrt/direct.h"
          export *
        }

        module types {
          header "sdk/ucrt/sys/types.h"
          export *
        }

        module utime {
          header "sdk/ucrt/sys/utime.h"
          export *
        }
      }
    }
  }

  module process {
    header "sdk/ucrt/process.h"
    export *
  }

  module corecrt {
    header "sdk/ucrt/corecrt.h"
    header "sdk/ucrt/corecrt_stdio_config.h"
    export *

    module io {
      header "sdk/ucrt/corecrt_io.h"
      export *
    }

    module math {
      header "sdk/ucrt/corecrt_math.h"
      export *
    }

    module stdio {
      header "sdk/ucrt/corecrt_wstdio.h"
      export *
    }
  }
}
